---
import { getAllPosts, getRecentPosts, buildTaxonomyIndex, getCollectionRoute, getCollectionLabel, slugify } from "../lib/content";

const allPosts = await getAllPosts();
const recentPosts = await getRecentPosts(5);
const { categories, tags } = buildTaxonomyIndex(allPosts);

const sortedCategories = Array.from(categories.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);
const sortedTags = Array.from(tags.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);

const sectionCollections = [
  { name: "sorkari-seba", label: getCollectionLabel("sorkari-seba"), href: "/sorkari-seba/" },
  { name: "exam-o-vorti", label: getCollectionLabel("exam-o-vorti"), href: "/exam-o-vorti/" },
  { name: "local-guide", label: getCollectionLabel("local-guide"), href: "/local-guide/" },
];
---

<div class="space-y-6">
  {/* About Widget */}
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-center gap-3 mb-3">
      <svg width="40" height="40" viewBox="0 0 100 100" class="rounded-lg shrink-0">
        <rect width="100" height="100" rx="20" fill="#006a4e"/>
        <circle cx="50" cy="50" r="28" fill="#f42a41"/>
        <text x="50" y="58" text-anchor="middle" fill="white" font-size="32" font-weight="bold" font-family="system-ui">শ</text>
      </svg>
      <div>
        <h3 class="font-bold text-slate-900">Shohoj BD</h3>
        <p class="text-xs text-slate-500">বাংলাদেশের তথ্যভিত্তিক ব্লগ</p>
      </div>
    </div>
    <p class="text-sm text-slate-600 leading-relaxed">
      সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্য সহজ বাংলায়। আপনার প্রয়োজনীয় সব তথ্য এক জায়গায়।
    </p>
  </div>

  {/* Recent Posts */}
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="font-bold text-slate-900 mb-4 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
      সাম্প্রতিক পোস্ট
    </h3>
    <ul class="space-y-3">
      {recentPosts.map((post) => (
        <li>
          <a href={`/${getCollectionRoute(post.collection)}/${slugify(post.id)}/`} class="group block">
            <h4 class="text-sm font-medium text-slate-700 group-hover:text-emerald-700 transition line-clamp-2">
              {post.data.title}
            </h4>
            <p class="text-xs text-slate-400 mt-0.5">
              {new Date(post.data.pubDate).toLocaleDateString("bn-BD", { year: "numeric", month: "short", day: "numeric" })}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* Categories */}
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="font-bold text-slate-900 mb-4 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
      বিভাগ
    </h3>
    <ul class="space-y-2">
      {sectionCollections.map((sec) => (
        <li>
          <a href={sec.href} class="flex items-center justify-between text-sm text-slate-600 hover:text-emerald-700 transition group">
            <span>{sec.label}</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-400 group-hover:bg-emerald-50 group-hover:text-emerald-600 transition">
              {allPosts.filter(p => p.collection === sec.name).length}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* Tag Cloud */}
  {sortedTags.length > 0 && (
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="font-bold text-slate-900 mb-4 flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
        ট্যাগ ক্লাউড
      </h3>
      <div class="flex flex-wrap gap-2">
        {sortedTags.slice(0, 20).map(([slug, data]) => (
          <a
            href={`/tag/${slug}/`}
            class="rounded-full bg-slate-50 px-3 py-1 text-xs font-medium text-slate-600 border border-slate-100 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-200 transition"
            title={`${data.label} — ${data.entries.length}টি পোস্ট`}
          >
            {data.label}
          </a>
        ))}
      </div>
    </div>
  )}

  {/* Newsletter */}
  <div class="rounded-2xl border border-slate-200 bg-emerald-50/50 p-5 shadow-sm">
    <h3 class="font-bold text-slate-900 mb-2 flex items-center gap-2">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      নিউজলেটার
    </h3>
    <p class="text-sm text-slate-600 mb-3">নতুন পোস্টের আপডেট পেতে সাবস্ক্রাইব করুন।</p>
    <form
      onsubmit="event.preventDefault(); alert('নিউজলেটার সেবা শীঘ্রই আসছে!');"
      class="flex gap-2"
    >
      <input
        type="email"
        placeholder="আপনার ইমেইল"
        required
        class="flex-1 min-w-0 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm text-slate-700 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500"
      />
      <button
        type="submit"
        class="shrink-0 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition"
      >
        সাবস্ক্রাইব
      </button>
    </form>
  </div>

  {/* Social Links */}
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h3 class="font-bold text-slate-900 mb-3">আমাদের অনুসরণ করুন</h3>
    <div class="flex items-center gap-3">
      <a href="#" class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-blue-600 text-white hover:bg-blue-500 transition" aria-label="Facebook">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a href="#" class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-red-600 text-white hover:bg-red-500 transition" aria-label="YouTube">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
    </div>
  </div>
</div>
