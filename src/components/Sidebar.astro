---
import { buildTaxonomyIndex, getCollectionRoute, slugify } from "../lib/content";

interface Props {
  posts?: any[];
}

const { posts = [] } = Astro.props;
const featuredToday = posts
  .filter((p) => p.data.featured && new Date(p.data.pubDate).getTime() >= Date.now() - 24 * 60 * 60 * 1000)
  .slice(0, 3);
const recentPosts = [...posts]
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5);
const { categories, tags } = buildTaxonomyIndex(posts);

const sortedCategories = Array.from(categories.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);
const sortedTags = Array.from(tags.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);
---

<div class="space-y-6">
  <!-- About widget removed; sidebar now starts with Recent Posts -->

  {/* Featured (last 24h) */}
  {featuredToday.length > 0 && (
    <div class="rounded-2xl border p-5 shadow-sm" style="border-color: var(--border); background: var(--surface);">
      <h3 class="font-bold mb-4 flex items-center gap-2" style="color: var(--text);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M12 .587l3.668 7.431L24 9.748l-6 5.84L19.335 24 12 20.201 4.665 24 6 15.588 0 9.748l8.332-1.73L12 .587z"/></svg>
        ফিচার্ড পোস্ট
      </h3>
      <ul class="space-y-3">
        {featuredToday.map((post) => (
          <li>
            <a href={`/${getCollectionRoute(post.collection)}/${slugify(post.id)}/`} class="group block">
              <h4 class="text-sm font-medium transition line-clamp-2" style="color: var(--text);">
                {post.data.title}
              </h4>
              <p class="text-xs mt-0.5" style="color: var(--text-muted);">
                {new Date(post.data.pubDate).toLocaleDateString("bn-BD", { year: "numeric", month: "short", day: "numeric" })}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  {/* Recent Posts */}
  <div class="rounded-2xl border p-5 shadow-sm" style="border-color: var(--border); background: var(--surface);">
    <h3 class="font-bold mb-4 flex items-center gap-2" style="color: var(--text);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
      সাম্প্রতিক পোস্ট
    </h3>
    <ul class="space-y-3">
      {recentPosts.map((post) => (
        <li>
          <a href={`/${getCollectionRoute(post.collection)}/${slugify(post.id)}/`} class="group block">
            <h4 class="text-sm font-medium transition line-clamp-2 group-hover:text-emerald-700" style="color: var(--text-muted);">
              {post.data.title}
            </h4>
            <p class="text-xs mt-0.5" style="color: var(--text-muted);">
              {new Date(post.data.pubDate).toLocaleDateString("bn-BD", { year: "numeric", month: "short", day: "numeric" })}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* Categories */}
  <div class="rounded-2xl border p-5 shadow-sm" style="border-color: var(--border); background: var(--surface);">
    <h3 class="font-bold mb-4 flex items-center gap-2" style="color: var(--text);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><path d="M6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
      ক্যাটাগরি
    </h3>
    <ul class="space-y-2">
      {sortedCategories.slice(0, 10).map(([slug, data]) => (
        <li>
          <a href={`/category/${slug}/`} class="flex items-center justify-between text-sm transition group" style="color: var(--text-muted);">
            <span>{data.label}</span>
            <span class="rounded-full px-2 py-0.5 text-xs transition group-hover:text-emerald-600" style="background: var(--surface-muted); color: var(--text-muted);">
              {data.entries.length}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  {/* Tag */}
  {sortedTags.length > 0 && (
    <div class="rounded-2xl border p-5 shadow-sm" style="border-color: var(--border); background: var(--surface);">
      <h3 class="font-bold mb-4 flex items-center gap-2" style="color: var(--text);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
        ট্যাগ
      </h3>
      <div class="flex flex-wrap gap-2">
        {sortedTags.slice(0, 10).map(([slug, data]) => (
          <a
            href={`/tag/${slug}/`}
            class="rounded-full px-3 py-1 text-xs font-medium border transition"
            style="background: var(--surface-muted); color: var(--text-muted); border-color: var(--border);"
            title={`${data.label} — ${data.entries.length}টি পোস্ট`}
          >
            {data.label}
          </a>
        ))}
      </div>
    </div>
  )}

</div>

<style>
  input::placeholder {
    color: var(--text-muted);
  }

  input:focus {
    --tw-ring-color: var(--primary);
  }
</style>
