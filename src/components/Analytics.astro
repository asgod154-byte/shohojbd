---
// Privacy-friendly Plausible Analytics
// Alternative: Use Google Analytics 4 if needed
// To use: set VITE_ANALYTICS_DOMAIN environment variable
// Example: VITE_ANALYTICS_DOMAIN=shohojbd.pages.dev

const analyticsDomain = "shohojbd.pages.dev";
---

<script define:vars={{ analyticsDomain }} defer data-domain={analyticsDomain} src="https://plausible.io/js/script.js" is:inline>
</script>

