---
---
const { title, description, href } = Astro.props;
---
<article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:shadow-lg">
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-xl font-semibold text-slate-900">{title}</h2>
    <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-emerald-700">Guide</span>
  </div>
  <p class="mt-4 text-slate-600">{description}</p>
  <a class="mt-6 inline-flex items-center rounded-full bg-emerald-700 px-4 py-2 text-sm font-medium text-white transition hover:bg-emerald-800" href={href}>Read more</a>
</article>
