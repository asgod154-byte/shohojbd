---
---
const { items = [] } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm text-slate-600">
  <ol class="inline-flex flex-wrap items-center gap-3">
    {items.map((item, index) => (
      <li class="inline-flex items-center" key={item.href}>
        <a class="rounded-full bg-slate-100 px-3 py-1 text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-900" href={item.href}>{item.title}</a>
        {index < items.length - 1 ? <span aria-hidden="true" class="text-slate-400">›</span> : null}
      </li>
    ))}
  </ol>
</nav>
