---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../Sidebar.astro";
import Breadcrumb from "../Breadcrumb.astro";
import TableOfContents from "../TableOfContents.astro";
import ShareButtons from "../ShareButtons.astro";
import AuthorBox from "../AuthorBox.astro";
import RelatedPosts from "../RelatedPosts.astro";
import ReadingProgress from "../ReadingProgress.astro";
import SavePost from "../SavePost.astro";
import { getEntrySlug, getEntryUrl, getCollectionLabel, getAllPosts, formatDate } from "../../lib/content";
import ContentAgeWarning from "../ContentAgeWarning.astro";
import { estimateReadingTime } from "../../lib/utils";
import { buildBreadcrumbJsonLd, buildArticleJsonLd, buildFaqJsonLd, buildHowToJsonLd } from "../../lib/schema";
import { slugify } from "../../lib/content";

interface Props {
  post: any;
  type: "sorkari-seba" | "exam-o-vorti" | "local-guide";
}

const { post, type } = Astro.props;
const { Content, headings } = await render(post);
const url = getEntryUrl(post);
const readingTime = estimateReadingTime(post.body || "");
const categoryLabel = getCollectionLabel(type);

const metaDescription = post.data.description || (post.body?.slice(0, 160).replace(/[#*`]/g, "").trim() + "...") || "";
const ogImage = post.data.coverImage || "/social-share-default.svg";

const allPosts = await getAllPosts();
const sortedPosts = [...allPosts].sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const currentIndex = sortedPosts.findIndex((p) => getEntrySlug(p) === getEntrySlug(post));
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: `/${type}/` },
  { title: post.data.title, href: url },
];

const articleJsonLd = buildArticleJsonLd({
  title: post.data.title,
  description: metaDescription,
  url,
  pubDate: post.data.pubDate.toISOString(),
  updatedDate: post.data.updatedDate?.toISOString(),
  author: post.data.author,
  image: ogImage,
});

const faqJsonLd = buildFaqJsonLd(post.data.faq);
const howToJsonLd = buildHowToJsonLd({
  title: post.data.title,
  description: metaDescription,
  url,
  steps: (post.data as any).steps,
});
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const jsonLd = [articleJsonLd, breadcrumbJsonLd, faqJsonLd, howToJsonLd].filter(Boolean);

const heroBgClass = type === "sorkari-seba" ? "bg-emerald-50" : type === "exam-o-vorti" ? "bg-sky-50" : "bg-amber-50";
const badgeClass = type === "sorkari-seba" ? "bg-emerald-50 text-emerald-700 hover:bg-emerald-100" : type === "exam-o-vorti" ? "bg-sky-50 text-sky-700 hover:bg-sky-100" : "bg-amber-50 text-amber-700 hover:bg-amber-100";
---

<Layout
  title={post.data.title}
  description={metaDescription}
  url={url}
  image={ogImage}
  jsonLd={jsonLd.length === 1 ? jsonLd[0] : jsonLd}
  article={true}
  pubDate={post.data.pubDate.toISOString()}
  updatedDate={(post.data.updatedDate || post.data.pubDate).toISOString()}
  author={post.data.author}
  category={post.data.category}
  tags={post.data.tags}
>
  <ReadingProgress />
  <div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
      <article class="min-w-0">
        <Breadcrumb items={breadcrumbItems} />

        {post.data.coverImage && (
          <div class={"mb-6 aspect-video rounded-2xl overflow-hidden " + heroBgClass}>
            <img src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} class="w-full h-full object-cover" width="1200" height="630" fetchpriority="high" />
          </div>
        )}

        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <a href={`/${type}/`} class={"inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold transition " + badgeClass}>
              {categoryLabel}
            </a>
            <span class="text-xs text-[var(--text-muted)]">{formatDate(post.data.pubDate)}</span>
            {post.data.updatedDate && post.data.updatedDate.toISOString() !== post.data.pubDate.toISOString() && (
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-700">
                🔄 সর্বশেষ হালনাগাদ: {formatDate(post.data.updatedDate)}
              </span>
            )}
          </div>
          <h1 class="text-2xl font-extrabold text-[var(--text)] sm:text-3xl lg:text-4xl leading-tight">{post.data.title}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-[var(--text-muted)]">
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {post.data.author}
              <span class="inline-flex items-center text-emerald-600" title="Verified author" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {readingTime} মিনিট পড়ুন
            </span>
          </div>
        </header>

        <ContentAgeWarning pubDate={post.data.pubDate} />

        <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-[var(--text)] prose-a:text-emerald-700 prose-a:no-underline hover:prose-a:underline prose-blockquote:border-emerald-500 prose-blockquote:bg-[var(--surface-muted)] prose-blockquote:rounded-r-lg prose-img:rounded-xl prose-table:border-collapse prose-th:bg-emerald-50 prose-th:font-semibold prose-td:border prose-td:border-[var(--border)] prose-th:border prose-th:border-[var(--border)]">
          <Content />
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-[var(--text-muted)] mr-1">ট্যাগ:</span>
            {post.data.tags.map((tag: string) => (
              <a href={`/tag/${slugify(tag)}/`} class="rounded-full bg-[var(--surface-alt)] px-3 py-1 text-sm text-[var(--text-muted)] hover:bg-[var(--surface-muted)] hover:text-emerald-700 transition">
                {tag}
              </a>
            ))}
          </div>
        )}

        {post.data.officialLinks && post.data.officialLinks.length > 0 && (
          <div class="mt-8 rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5">
            <h3 class="text-sm font-bold text-[var(--text)] mb-3 flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              অফিসিয়াল লিংক
            </h3>
            <ul class="space-y-2">
              {post.data.officialLinks.map((link: any) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-sm text-emerald-700 hover:underline inline-flex items-center gap-1">
                    {link.label}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {(() => {
          const faq = post.data.faq;
          if (!faq || faq.length === 0) return null;
          const parsed = typeof faq === "string" ? JSON.parse(faq) : faq;
          return (
            <section class="mt-8">
              <h3 class="text-xl font-bold mb-4 text-[var(--text)] dark:text-white">সচরাচর জিজ্ঞাসা</h3>
              <div class="space-y-3">
                {parsed.map((item: any) => (
                  <details class="group border border-[var(--border)] dark:border-gray-700 rounded-lg bg-[var(--surface)] dark:bg-gray-800 overflow-hidden">
                    <summary class="flex items-center justify-between cursor-pointer list-none p-4 hover:bg-[var(--surface-muted)] dark:hover:bg-gray-700 transition">
                      <span class="font-semibold text-[var(--text)] dark:text-white pr-4">{item.question}</span>
                      <svg class="shrink-0 w-5 h-5 text-[var(--text-muted)] dark:text-gray-400 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="px-4 pb-4 text-[var(--text-muted)] dark:text-gray-400">
                      <p>{item.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          );
        })()}

        <div class="mt-8 pt-6 border-t border-[var(--border)] print-hidden">
          <ShareButtons url={url} title={post.data.title} />
        </div>

        <button type="button" class="mt-4 inline-flex items-center gap-2 rounded-lg border border-[var(--border)] dark:border-gray-700 px-4 py-2 text-sm font-medium text-[var(--text-muted)] dark:text-gray-300 hover:bg-[var(--surface-muted)] dark:hover:bg-gray-800 transition print-hidden" onclick="window.print()">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          প্রিন্ট করুন
        </button>

        <div class="mt-3 print-hidden">
          <SavePost postId={post.data.title} title={post.data.title} url={url} />
        </div>

        <AuthorBox author={post.data.author} />

        <RelatedPosts currentPost={post} posts={allPosts} />

        <nav class="flex justify-between mt-12 pt-8 border-t border-[var(--border)] dark:border-gray-700" aria-label="Post navigation">
          {prevPost && (
            <a href={getEntryUrl(prevPost)} class="group inline-flex items-center gap-2 rounded-lg border border-[var(--border)] dark:border-gray-700 px-4 py-3 text-sm text-[var(--text)] dark:text-gray-300 hover:bg-[var(--surface-muted)] dark:hover:bg-gray-800 transition max-w-[45%]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
              <span class="line-clamp-1">{prevPost.data.title}</span>
            </a>
          )}
          <span></span>
          {nextPost && (
            <a href={getEntryUrl(nextPost)} class="group ml-auto inline-flex items-center gap-2 rounded-lg border border-[var(--border)] dark:border-gray-700 px-4 py-3 text-sm text-[var(--text)] dark:text-gray-300 hover:bg-[var(--surface-muted)] dark:hover:bg-gray-800 transition max-w-[45%]">
              <span class="line-clamp-1">{nextPost.data.title}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          )}
        </nav>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <TableOfContents headings={headings} />
          <Sidebar />
        </div>
      </aside>
    </div>
  </div>
</Layout>