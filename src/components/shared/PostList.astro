---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import PostCard from "../PostCard.astro";
import Breadcrumb from "../Breadcrumb.astro";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

interface Props {
  posts: any[];
  title: string;
  description: string;
  breadcrumbItems: Array<{ title: string; href: string }>;
}

const { posts, title, description, breadcrumbItems } = Astro.props;
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title={title}
  description={description}
  url={`https://shohojbd.pages.dev${Astro.url.pathname}`}
  image="/social-share-default.svg"
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-[var(--text-muted)]">{description}</p>
  </section>
  <section class="grid gap-6 sm:grid-cols-2">
    {posts.map((post: any) => (
      <PostCard post={post} variant="vertical" />
    ))}
  </section>
</LayoutWithSidebar>