---
import { Image } from "astro:assets";
import { getCollectionRoute, slugify, formatDate, estimateReadingTime } from "../lib/content";

interface Props {
  post: any;
  variant?: "vertical" | "horizontal";
}

const { post, variant = "vertical" } = Astro.props;
const url = `/${getCollectionRoute(post.collection)}/${slugify(post.id)}/`;
const readingTime = estimateReadingTime(post.body || "");
---

{variant === "vertical" ? (
  <article class="group overflow-hidden rounded-2xl border transition hover:shadow-lg hover:-translate-y-0.5" style="border-color: var(--border); background: var(--surface);">
    <a href={url} class="block">
      <div class="aspect-video flex items-center justify-center overflow-hidden" style="background: var(--surface-muted);">
        {post.data.coverImage ? (
          <Image 
            src={post.data.coverImage} 
            alt={post.data.coverImageAlt || post.data.title} 
            width={1200} 
            height={630}
            format="webp"
            quality={80}
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
          />
        ) : (
          <div class="flex flex-col items-center justify-center" style="color: var(--primary);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            <span class="text-xs mt-1">Shohoj BD</span>
          </div>
        )}
      </div>
    </a>
    <div class="p-5">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold" style="background: var(--surface-muted); color: var(--primary);">
          {post.data.category}
        </span>
        <span class="text-xs" style="color: var(--text-muted);">{formatDate(post.data.pubDate)}</span>
      </div>
      <a href={url} class="block">
        <h2 class="text-lg font-bold transition line-clamp-2" style="color: var(--text);">
          {post.data.title}
        </h2>
      </a>
      <p class="mt-2 text-sm line-clamp-2 leading-relaxed" style="color: var(--text-muted);">
        {post.data.description}
      </p>
      <div class="mt-4 flex items-center justify-between">
        <span class="text-xs" style="color: var(--text-muted);">{readingTime} মিনিট পড়ুন</span>
        <a href={url} class="text-sm font-medium transition inline-flex items-center gap-1" style="color: var(--primary);">
          আরও পড়ুন
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </article>
) : (
  <article class="group flex gap-4 rounded-xl border p-3 transition hover:shadow-md hover:-translate-y-0.5" style="border-color: var(--border); background: var(--surface);">
    <a href={url} class="shrink-0">
      <div class="w-24 h-24 rounded-lg flex items-center justify-center overflow-hidden sm:w-28 sm:h-28" style="background: var(--surface-muted);">
        {post.data.coverImage ? (
          <Image 
            src={post.data.coverImage} 
            alt={post.data.coverImageAlt || post.data.title} 
            width={1200} 
            height={630}
            format="webp"
            quality={80}
            class="w-full h-full object-cover" 
          />
        ) : (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--primary);"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        )}
      </div>
    </a>
    <div class="flex flex-col justify-center min-w-0">
      <span class="text-xs font-medium mb-1" style="color: var(--primary);">{post.data.category}</span>
      <a href={url} class="block">
        <h3 class="text-sm font-bold transition line-clamp-2" style="color: var(--text);">
          {post.data.title}
        </h3>
      </a>
      <p class="mt-1 text-xs line-clamp-2 hidden sm:block" style="color: var(--text-muted);">{post.data.description}</p>
      <span class="mt-1.5 text-xs" style="color: var(--text-muted);">{formatDate(post.data.pubDate)} · {readingTime} মিনিট</span>
    </div>
  </article>
)}
