---
import { getCollectionRoute, slugify, formatDate, estimateReadingTime } from "../lib/content";

interface Props {
  post: any;
  variant?: "vertical" | "horizontal";
}

const { post, variant = "vertical" } = Astro.props;
const url = `/${getCollectionRoute(post.collection)}/${slugify(post.id)}/`;
const readingTime = estimateReadingTime(post.body || "");
---

{variant === "vertical" ? (
  <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition hover:shadow-lg hover:-translate-y-0.5">
    <a href={url} class="block">
      <div class="aspect-video bg-emerald-50 flex items-center justify-center overflow-hidden">
        {post.data.coverImage ? (
          <img src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-500" loading="lazy" />
        ) : (
          <div class="flex flex-col items-center justify-center text-emerald-200">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            <span class="text-xs mt-1">Shohoj BD</span>
          </div>
        )}
      </div>
    </a>
    <div class="p-5">
      <div class="flex items-center gap-2 mb-2">
        <span class="inline-flex items-center rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700">
          {post.data.category}
        </span>
        <span class="text-xs text-slate-400">{formatDate(post.data.pubDate)}</span>
      </div>
      <a href={url} class="block">
        <h2 class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition line-clamp-2">
          {post.data.title}
        </h2>
      </a>
      <p class="mt-2 text-sm text-slate-600 line-clamp-2 leading-relaxed">
        {post.data.description}
      </p>
      <div class="mt-4 flex items-center justify-between">
        <span class="text-xs text-slate-400">{readingTime} মিনিট পড়ুন</span>
        <a href={url} class="text-sm font-medium text-emerald-700 hover:text-emerald-800 transition inline-flex items-center gap-1">
          আরও পড়ুন
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
    </div>
  </article>
) : (
  <article class="group flex gap-4 rounded-xl border border-slate-200 bg-white p-3 transition hover:shadow-md hover:-translate-y-0.5">
    <a href={url} class="shrink-0">
      <div class="w-24 h-24 rounded-lg bg-emerald-50 flex items-center justify-center overflow-hidden sm:w-28 sm:h-28">
        {post.data.coverImage ? (
          <img src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} class="w-full h-full object-cover" loading="lazy" />
        ) : (
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-emerald-200"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
        )}
      </div>
    </a>
    <div class="flex flex-col justify-center min-w-0">
      <span class="text-xs font-medium text-emerald-700 mb-1">{post.data.category}</span>
      <a href={url} class="block">
        <h3 class="text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition line-clamp-2">
          {post.data.title}
        </h3>
      </a>
      <p class="mt-1 text-xs text-slate-500 line-clamp-2 hidden sm:block">{post.data.description}</p>
      <span class="mt-1.5 text-xs text-slate-400">{formatDate(post.data.pubDate)} · {readingTime} মিনিট</span>
    </div>
  </article>
)}
