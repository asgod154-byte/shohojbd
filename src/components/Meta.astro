---
interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  alternateTag?: boolean;
  jsonLd?: any;
}

const {
  title,
  description,
  url,
  image,
  alternateTag = false,
  jsonLd,
} = Astro.props;

const pageUrl = url || "https://shohojbd.pages.dev";
const pageImage = image?.startsWith("http") ? image : `https://shohojbd.pages.dev${image}`;
---

<title data-editable="text" data-prop="title">{title}</title>
<meta data-editable="text" data-prop="description" name="description" content={description} />
<meta name="author" content="Shohoj BD" />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={pageUrl} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Shohoj BD" />
<meta property="og:locale" content="bn_BD" />
<meta data-editable="text" data-prop="title" property="og:title" content={title} />
<meta data-editable="text" data-prop="description" property="og:description" content={description} />
<meta property="og:image" content={pageImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:url" content={pageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta data-editable="text" data-prop="title" name="twitter:title" content={title} />
<meta data-editable="text" data-prop="description" name="twitter:description" content={description} />
<meta name="twitter:image" content={pageImage} />
{alternateTag ? <link rel="alternate" hreflang="bn" href={pageUrl} /> : null}
{jsonLd ? <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} /> : null}
