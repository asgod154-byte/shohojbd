---
const navItems = [
  { label: "হোম", href: "/" },
  {
    label: "সরকারি সেবা",
    href: "/sorkari-seba/",
    children: [
      { label: "সব পোস্ট", href: "/sorkari-seba/" },
      { label: "NID সেবা", href: "/tag/nid/" },
      { label: "জন্ম নিবন্ধন", href: "/tag/jonmo-nibondon/" },
      { label: "চাকরি", href: "/tag/chakri/" },
    ],
  },
  {
    label: "পরীক্ষা ও ভর্তি",
    href: "/exam-o-vorti/",
    children: [
      { label: "সব পোস্ট", href: "/exam-o-vorti/" },
      { label: "বিসিএস", href: "/tag/bcs/" },
      { label: "বিশ্ববিদ্যালয় ভর্তি", href: "/tag/bishwobidyaloy/" },
      { label: "শিক্ষা", href: "/tag/shikkha/" },
    ],
  },
  {
    label: "স্থানীয় গাইড",
    href: "/local-guide/",
    children: [
      { label: "সব পোস্ট", href: "/local-guide/" },
      { label: "পরিবহন", href: "/tag/paribohon/" },
      { label: "ভ্রমণ", href: "/tag/bhromon/" },
    ],
  },
  { label: "আমরা", href: "/about/" },
  { label: "যোগাযোগ", href: "/contact/" },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md border-b shadow-sm" style="background: color-mix(in srgb, var(--surface) 95%, transparent); border-bottom-color: var(--border);">
  <div class="container mx-auto">
    <div class="flex h-16 items-center justify-between gap-4">
      {/* Logo */}
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Shohoj BD হোমপেজ">
        <img src="/favicon_io/android-chrome-512x512.png" alt="Shohoj BD logo" width="36" height="36" class="rounded-lg object-cover" />
        <span class="text-xl font-bold tracking-tight hidden sm:inline" style="color: var(--text);">Shohoj BD</span>
      </a>

      {/* Desktop Nav */}
      <nav class="hidden lg:flex items-center gap-1" aria-label="প্রধান নেভিগেশন">
        {navItems.map((item) => (
          <div class="relative group">
            {item.children ? (
              <button
                type="button"
                class="inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition hover:text-emerald-800"
                style="color: var(--text-muted);"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {item.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 group-hover:rotate-180 transition-transform duration-200">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </button>
            ) : (
              <a
                href={item.href}
                class="inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium transition hover:text-emerald-800"
                style="color: var(--text-muted);"
              >
                {item.label}
              </a>
            )}
            {item.children && (
              <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 z-50">
                <div class="rounded-xl border shadow-lg py-2 min-w-[200px]" style="border-color: var(--border); background: var(--surface);">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2.5 text-sm transition hover:text-emerald-800"
                      style="color: var(--text-muted);"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      {/* Search + Actions */}
      <div class="flex items-center gap-2">
        <a
          href="/search/"
          class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition hover:text-emerald-700"
          style="color: var(--text-muted);"
          aria-label="অনুসন্ধান"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </a>

        {/* Dark Mode Toggle */}
        <button
          id="theme-toggle"
          class="inline-flex items-center justify-center w-9 h-9 rounded-lg transition hover:text-emerald-700"
          style="color: var(--text-muted);"
          aria-label="থিম পরিবর্তন"
        >
          <svg id="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <circle cx="12" cy="12" r="5"/><path d="M12 1v6m0 6v6M4.22 4.22l4.24 4.24m2.98 2.98l4.24 4.24M1 12h6m6 0h6M4.22 19.78l4.24-4.24m2.98-2.98l4.24-4.24M19.78 19.78l-4.24-4.24m-2.98-2.98l-4.24-4.24"/>
          </svg>
          <svg id="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        {/* Mobile Menu Toggle */}
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-lg transition cursor-pointer hover:text-emerald-700"
          style="color: var(--text-muted);"
          aria-label="মেনু খুলুন"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="menu-open-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h18M3 6h18M3 18h18"/>
          </svg>
          <svg id="menu-close-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
        <div id="mobile-menu" class="lg:hidden hidden absolute right-0 top-full mt-2 w-64 rounded-xl border shadow-xl p-2 z-50" style="border-color: var(--border); background: var(--surface);">
          {navItems.map((item) => (
            <div>
              <a
                href={item.href}
                class="block rounded-lg px-4 py-2.5 text-sm font-medium transition hover:text-emerald-800"
                style="color: var(--text-muted);"
              >
                {item.label}
              </a>
              {item.children && (
                <div class="ml-4 border-l-2 pl-2 mt-1 mb-1" style="border-left-color: var(--border);">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-lg px-4 py-2 text-sm transition hover:text-emerald-700"
                      style="color: var(--text-muted);"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  function initThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    if (themeToggle?.getAttribute('data-bound') === 'true') {
      return;
    }

    const currentTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    html.setAttribute('data-theme', currentTheme);
    html.style.colorScheme = currentTheme;
    updateIcons(currentTheme);

    themeToggle?.addEventListener('click', () => {
      const theme = html.getAttribute('data-theme');
      const newTheme = theme === 'light' ? 'dark' : 'light';
      html.setAttribute('data-theme', newTheme);
      html.style.colorScheme = newTheme;
      localStorage.setItem('theme', newTheme);
      updateIcons(newTheme);
    });

    themeToggle?.setAttribute('data-bound', 'true');

    function updateIcons(theme: string) {
      if (theme === 'dark') {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }
  }

  function initDesktopDropdowns() {
    document.querySelectorAll('.group > button[aria-haspopup="true"]').forEach((btn) => {
      if (btn.getAttribute('data-bound') === 'true') return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
      });

      btn.setAttribute('data-bound', 'true');
    });
  }

  function initMobileMenu() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (!menuBtn || !mobileMenu) return;

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      } else {
        mobileMenu.classList.remove('hidden');
        menuBtn.setAttribute('aria-expanded', 'true');
        openIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
      }
    });

    document.addEventListener('click', (e) => {
      if (!mobileMenu.classList.contains('hidden') &&
          !mobileMenu.contains(e.target as Node) &&
          e.target !== menuBtn &&
          !menuBtn?.contains(e.target as Node)) {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    });
  }

  initThemeToggle();
  initDesktopDropdowns();
  initMobileMenu();
  document.addEventListener('astro:after-swap', () => {
    initThemeToggle();
    initDesktopDropdowns();
    initMobileMenu();
  });
</script>



