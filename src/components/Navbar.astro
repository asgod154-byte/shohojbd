---
const items = [
  { label: "হোম", href: "/" },
  { label: "সরকারি সেবা", href: "/sorkari-seba/" },
  { label: "পরীক্ষা ও ভর্তি", href: "/exam-o-vorti/" },
  { label: "লোকাল গাইড", href: "/local-guide/" },
  { label: "আমরা", href: "/about/" },
  { label: "যোগাযোগ", href: "/contact/" },
];
---

<nav class="bg-white/95 backdrop-blur border-b border-slate-200 sticky top-0 z-50 shadow-sm">
  <div class="container mx-auto flex flex-wrap items-center justify-between gap-3 px-4 py-4 sm:px-6">
    <a href="/" class="text-xl font-semibold tracking-tight text-emerald-900">Shohoj BD</a>

    <div class="sm:hidden">
      <details class="group relative">
        <summary class="inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-medium text-slate-700 transition hover:border-emerald-200 hover:bg-emerald-100 focus:outline-none focus:ring-2 focus:ring-emerald-500">
          Menu
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-700">
            <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="mt-3 flex flex-col gap-2 rounded-3xl border border-slate-200 bg-white p-4 shadow-lg">
          {items.map((item) => (
            <a class="rounded-2xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-900" href={item.href}>
              {item.label}
            </a>
          ))}
        </div>
      </details>
    </div>

    <div class="hidden flex-wrap items-center gap-3 sm:flex">
      {items.map((item) => (
        <a class="rounded-full px-3 py-2 text-sm font-medium text-slate-700 transition hover:bg-emerald-50 hover:text-emerald-900" href={item.href}>
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>
