---
const currentYear = new Date().getFullYear();
const quickLinks = [
  { label: "হোম", href: "/" },
  { label: "সরকারি সেবা", href: "/sorkari-seba/" },
  { label: "পরীক্ষা ও ভর্তি", href: "/exam-o-vorti/" },
  { label: "স্থানীয় গাইড", href: "/local-guide/" },
  { label: "আমাদের সম্পর্কে", href: "/about/" },
  { label: "যোগাযোগ", href: "/contact/" },
  { label: "গোপনীয়তা নীতি", href: "/privacy/" },
];

const categories = [
  { label: "সরকারি সেবা", href: "/sorkari-seba/" },
  { label: "পরীক্ষা ও ভর্তি", href: "/exam-o-vorti/" },
  { label: "স্থানীয় গাইড", href: "/local-guide/" },
  { label: "ট্যাগ", href: "/tag/" },
  { label: "অনুসন্ধান", href: "/search/" },
];
---

<footer class="bg-emerald-950 text-emerald-100">
  <div class="container mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {/* Column 1: About */}
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 mb-4">
          <svg width="32" height="32" viewBox="0 0 100 100" class="rounded-lg">
            <rect width="100" height="100" rx="20" fill="#10b981"/>
            <circle cx="50" cy="50" r="28" fill="#f42a41"/>
            <text x="50" y="58" text-anchor="middle" fill="white" font-size="32" font-weight="bold" font-family="system-ui">শ</text>
          </svg>
          <span class="text-lg font-bold text-white">Shohoj BD</span>
        </a>
        <p class="text-sm leading-relaxed text-emerald-200/80">
          বাংলাদেশের সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্যের জন্য একটি পেশাদার বাংলা ব্লগ। তথ্যভিত্তিক, সহজ বাংলা অভিজ্ঞতা।
        </p>
      </div>

      {/* Column 2: Quick Links */}
      <div class="hidden sm:block">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-red-400 mb-4">দ্রুত লিংক</h3>
        <ul class="space-y-2.5">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-emerald-200/70 hover:text-white transition">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Column 3: Categories */}
      <div class="hidden sm:block">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-red-400 mb-4">ক্যাটাগরি</h3>
        <ul class="space-y-2.5">
          {categories.map((cat) => (
            <li>
              <a href={cat.href} class="text-sm text-emerald-200/70 hover:text-white transition">{cat.label}</a>
            </li>
          ))}
        </ul>
      </div>

      {/* Column 4: Newsletter */}
      <div class="hidden sm:block">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-red-400 mb-4">নিউজলেটার</h3>
        <p class="text-sm text-emerald-200/70 mb-4">নতুন পোস্ট ও গুরুত্বপূর্ণ আপডেট সরাসরি ইনবক্সে পেতে সাবস্ক্রাইব করুন।</p>
        <form
          action="https://formspree.io/f/YOUR_FORM_ID"
          method="POST"
          class="flex gap-2"
          onsubmit="event.preventDefault(); alert('নিউজলেটার সেবা শীঘ্রই আসছে!');"
        >
          <input
            type="email"
            name="email"
            placeholder="আপনার ইমেইল"
            required
            class="flex-1 min-w-0 rounded-lg bg-emerald-900/50 border border-emerald-700/50 px-3 py-2 text-sm text-white placeholder-emerald-400/50 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
          <button
            type="submit"
            class="shrink-0 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition"
          >
            সাবস্ক্রাইব
          </button>
        </form>
        <div class="mt-5 flex items-center gap-3">
          <a href="#" class="text-emerald-300 hover:text-white transition" aria-label="Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="text-emerald-300 hover:text-white transition" aria-label="YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-emerald-800/60 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-sm text-emerald-300/70">
        © {currentYear} Shohoj BD. সকল অধিকার সংরক্ষিত।
      </p>
      <p class="text-sm text-emerald-300/70">
        তথ্য যাচাইয়ের জন্য সব সময় অফিসিয়াল ওয়েবসাইট দেখুন।
      </p>
    </div>
  </div>

  {/* Back to top */}
  <button
    id="back-to-top"
    class="fixed bottom-6 right-6 z-40 hidden rounded-full bg-emerald-600 p-3 text-white shadow-lg hover:bg-emerald-500 transition"
    aria-label="উপরে যান"
    onclick="window.scrollTo({top:0,behavior:'smooth'})"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </button>

  <script is:inline>
    (function() {
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      window.addEventListener('scroll', function() {
        if (window.scrollY > 500) {
          btn.classList.remove('hidden');
        } else {
          btn.classList.add('hidden');
        }
      });
    })();
  </script>
</footer>
