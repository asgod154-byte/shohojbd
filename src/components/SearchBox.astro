---
<form action="/search/" method="get" class="relative">
  <input
    type="search"
    id="site-search"
    name="q"
    placeholder="অনুসন্ধান করুন..."
    class="w-full rounded-xl border border-slate-200 bg-white py-3 pl-11 pr-4 text-slate-700 placeholder-slate-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent"
    autocomplete="off"
    aria-label="Search Shohoj BD"
  />
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"
  >
    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
  </svg>
</form>
