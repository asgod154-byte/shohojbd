---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{toc.length > 2 && (
  <nav aria-label="সূচিপত্র" class="mb-8 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 mb-3">এই পোস্টের সূচিপত্র</h2>
    <ul class="space-y-1.5">
      {toc.map((heading) => (
        <li class={heading.depth === 3 ? "ml-4" : ""}>
          <a
            href={`#${heading.slug}`}
            class="block text-sm text-slate-600 hover:text-emerald-700 transition py-0.5"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
