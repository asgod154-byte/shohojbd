---
import Layout from "./Layout.astro";
import Sidebar from "../components/Sidebar.astro";
import { getAllPosts } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  jsonLd?: any;
  alternateTag?: boolean;
  noindex?: boolean;
  article?: boolean;
  pubDate?: string;
  updatedDate?: string;
  author?: string;
  category?: string;
  tags?: string[];
}

const {
  title,
  description = "বাংলাদেশের সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্যের জন্য একটি পেশাদার বাংলা ব্লগ। সহজ এবং দ্রুত খোঁজার জন্য তৈরি।",
  url = "https://shohojbd.pages.dev/",
  image = "/social-share-default.svg",
  jsonLd,
  alternateTag = false,
  noindex = false,
  article = false,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
} = Astro.props;

const allPosts = await getAllPosts();
---

<Layout
  title={title}
  description={description}
  url={url}
  image={image}
  jsonLd={jsonLd}
  alternateTag={alternateTag}
  noindex={noindex}
  article={article}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  category={category}
  tags={tags}
>
  <div class="container mx-auto py-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
      <div class="min-w-0">
        <slot />
      </div>
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <Sidebar posts={allPosts} />
          <slot name="sidebar" />
        </div>
      </aside>
    </div>
  </div>
</Layout>


