---
import Meta from "../components/Meta.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Analytics from "../components/Analytics.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  url?: string;
  image?: string;
  jsonLd?: any;
  alternateTag?: boolean;
}

const {
  title = "Shohoj BD",
  description = "বাংলাদেশের সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্যের জন্য একটি পেশাদার বাংলা ব্লগ। সহজ এবং দ্রুত খোঁজার জন্য তৈরি।",
  url = "https://shohojbd.pages.dev/",
  image = "/social-share-default.svg",
  jsonLd,
  alternateTag = false,
} = Astro.props;

const pageTitle = title === "Shohoj BD" ? title : `${title} | Shohoj BD`;
---

<!doctype html>
<html lang="bn" dir="ltr" data-theme="light">
  <head>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const initialTheme = savedTheme || systemTheme;
      document.documentElement.setAttribute("data-theme", initialTheme);
      document.documentElement.style.colorScheme = initialTheme;
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#006a4e" />
    <meta name="color-scheme" content="light dark" />
    <meta name="author" content="Shohoj BD" />
    <link rel="icon" href="/favicon_io/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/favicon_io/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon_io/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@300;400;500;600;700;800&display=swap"
      />
      <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
      </noscript>
    <Meta
      title={pageTitle}
      description={description}
      url={url}
      image={image}
      alternateTag={alternateTag}
      jsonLd={jsonLd}
    />
    <style>
      /* Minimal critical CSS to reduce render-blocking and CLS */
      html { background: #f8fafc; }
      body { color: #0f172a; margin: 0; }
      .container { max-width: 1100px; }
      .copy-code-button {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        border: 0;
        border-radius: 0.5rem;
        background: rgba(15, 23, 42, 0.8);
        color: white;
        padding: 0.35rem 0.55rem;
        font-size: 0.72rem;
        opacity: 0;
        transition: opacity 0.16s ease;
        cursor: pointer;
      }
      pre:hover .copy-code-button,
      pre:focus-within .copy-code-button {
        opacity: 1;
      }
      .lightbox-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.82);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        z-index: 200;
      }
      .lightbox-backdrop img {
        max-width: 100%;
        max-height: 90vh;
        border-radius: 1rem;
        background: white;
        box-shadow: 0 18px 60px rgba(15, 23, 42, 0.38);
      }
    </style>
  </head>
  <body class="min-h-screen font-[var(--font-bangla)]" style="background: var(--surface-muted); color: var(--text);">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-emerald-900 focus:px-5 focus:py-2.5 focus:text-sm focus:font-medium focus:text-white focus:shadow-lg"
    >
      মূল কন্টেন্টে যান
    </a>
    <Navbar />
    <main id="main-content" class="min-h-[60vh]" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <ScrollToTop />
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            console.warn("Service worker registration failed");
          });
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        const codeBlocks = document.querySelectorAll("pre code");
        codeBlocks.forEach((code) => {
          const pre = code.parentElement;
          if (!pre || pre.querySelector(".copy-code-button")) return;

          const button = document.createElement("button");
          button.type = "button";
          button.className = "copy-code-button";
          button.textContent = "Copy";
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(code.textContent || "");
              button.textContent = "Copied";
              setTimeout(() => (button.textContent = "Copy"), 1800);
            } catch {
              button.textContent = "Copy failed";
              setTimeout(() => (button.textContent = "Copy"), 1800);
            }
          });
          pre.style.position = "relative";
          pre.appendChild(button);
        });

        document.querySelectorAll(".prose img").forEach((img) => {
          img.style.cursor = "zoom-in";
          img.addEventListener("click", () => {
            const backdrop = document.createElement("div");
            backdrop.className = "lightbox-backdrop";
            backdrop.setAttribute("role", "dialog");
            backdrop.setAttribute("aria-modal", "true");
            const clone = img.cloneNode(true);
            clone.style.maxWidth = "100%";
            clone.style.maxHeight = "90vh";
            backdrop.appendChild(clone);
            backdrop.addEventListener("click", () => backdrop.remove());
            document.body.appendChild(backdrop);
          });
        });
      });
    </script>
    <slot name="scripts" />
  </body>
</html>
