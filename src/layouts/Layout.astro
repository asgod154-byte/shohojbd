---
import Meta from "../components/Meta.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

---
const { title = "Shohoj BD", description = "বাংলাদেশের সরকারি সেবা, পরীক্ষা ও স্থানীয় গাইড সম্পূর্ণ গাইড।", url = "https://shohojbd.pages.dev/", image = "/social-share-default.svg", jsonLd } = Astro.props;
const pageTitle = title;
---

<html lang="bn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Meta title={pageTitle} description={description} url={url} image={image} jsonLd={jsonLd} alternateTag />
  </head>
  <body class="min-h-screen font-[var(--font-bangla)] text-slate-900 bg-slate-50">
    <a href="#main-content" class="sr-only focus:not-sr-only absolute left-4 top-4 rounded-full bg-emerald-900 px-4 py-2 text-sm font-medium text-white shadow-lg focus:z-50">Skip to content</a>
    <Navbar />
    <main id="main-content" class="container mx-auto px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
