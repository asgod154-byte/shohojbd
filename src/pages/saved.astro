---
import Layout from "../layouts/Layout.astro";
import { getAllPosts } from "../lib/content";

const allPosts = await getAllPosts();
const postsData = allPosts.map((p) => ({
  slug: p.slug || p.id.replace(/\.md$/, ''),
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate,
  image: p.data.coverImage,
  category: p.data.category,
  url: `/${p.collection}/${p.slug || p.id.replace(/\.md$/, '')}/`,
}));
---

<Layout
  title="সংরক্ষিত পোস্ট"
  description="আপনার সংরক্ষিত পোস্টের তালিকা।"
  url="https://shohojbd.pages.dev/saved/"
  image="/social-share-default.svg"
>
  <div class="container mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl mb-2">📚 সংরক্ষিত পোস্ট</h1>
    <p class="mb-8 text-lg text-[var(--text-muted)]" id="saved-count">লোড হচ্ছে...</p>

    <div id="saved-posts" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <div class="col-span-full rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center">
        <p class="text-[var(--text-muted)]">লোড হচ্ছে...</p>
      </div>
    </div>

    <div id="no-saved" class="hidden text-center py-12">
      <p class="text-lg text-[var(--text-muted)]">কোনো পোস্ট সেভ করা হয়নি।</p>
      <a href="/" class="text-[var(--primary)] hover:underline mt-2 inline-block">পোস্ট দেখতে যান</a>
    </div>
  </div>
</Layout>

<script define:vars={{ postsData }}>
  (function() {
    function getSavedPosts() {
      try {
        return JSON.parse(localStorage.getItem('shohojbd_saved') || '[]');
      } catch {
        return [];
      }
    }

    const container = document.getElementById('saved-posts');
    const noSaved = document.getElementById('no-saved');
    const countEl = document.getElementById('saved-count');
    const saved = getSavedPosts();

    countEl.textContent = saved.length > 0 ? `আপনার সংরক্ষিত পোস্ট ${saved.length}টি।` : 'আপনার সংরক্ষিত পোস্ট এখনো নেই।';

    if (saved.length === 0) {
      container.innerHTML = '';
      noSaved.classList.remove('hidden');
      return;
    }

    const savedUrls = saved.map(s => s.url);
    const savedPosts = postsData.filter((p) => savedUrls.includes(p.url));

    if (savedPosts.length === 0) {
      container.innerHTML = '';
      noSaved.classList.remove('hidden');
      return;
    }

    container.innerHTML = savedPosts.map((post) => `
      <article class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4 hover:shadow-lg transition">
        <a href="${post.url}" class="block">
          <p class="text-sm font-medium text-[var(--text)]">${post.title}</p>
          <p class="mt-1 text-xs text-[var(--text-muted)]">${new Date(post.pubDate).toLocaleDateString('bn-BD')}</p>
        </a>
      </article>
    `).join('');
  })();
</script>