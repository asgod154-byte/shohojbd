---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { buildBreadcrumbJsonLd } from "../lib/schema";

const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "যোগাযোগ", href: "/contact/" },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const FORMSPREE_ID = import.meta.env.FORMSPREE_ID || "";
const isFormReady = FORMSPREE_ID.length > 0;
---

<Layout
  title="যোগাযোগ"
  description="Shohoj BD-র সাথে যোগাযোগ করুন। প্রশ্ন, পরামর্শ ও ফিডব্যাক পাঠান।"
  url="https://shohojbd.pages.dev/contact/"
  image="/social-share-default.svg"
  jsonLd={jsonLd}
>
  <div class="container mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <Breadcrumb items={breadcrumbItems} />
    <div class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl mb-2">যোগাযোগ করুন</h1>
      <p class="text-lg text-[var(--text-muted)] mb-8">যেকোনো প্রশ্ন, পরামর্শ বা ফিডব্যাকের জন্য নিচের ফর্মটি পূরণ করুন।</p>

      <form
        action={isFormReady ? `https://formspree.io/f/${FORMSPREE_ID}` : undefined}
        method="POST"
        class="space-y-5 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 shadow-sm sm:p-8"
      >
        <div>
          <label for="name" class="block text-sm font-medium text-[var(--text)] mb-1">নাম</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-[var(--text)] focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-[var(--text)] mb-1">ইমেইল</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-[var(--text)] focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>
        <div>
          <label for="subject" class="block text-sm font-medium text-[var(--text)] mb-1">বিষয়</label>
          <input
            type="text"
            id="subject"
            name="subject"
            required
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-[var(--text)] focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-[var(--text)] mb-1">বার্তা</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full rounded-lg border border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-[var(--text)] focus:outline-none focus:ring-2 focus:ring-[var(--primary)] resize-y"
          ></textarea>
        </div>
        {isFormReady ? (
          <button
            type="submit"
            class="w-full rounded-lg bg-[var(--primary)] px-6 py-3 text-sm font-semibold text-white hover:opacity-90 transition"
          >
            বার্তা পাঠান
          </button>
        ) : (
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-yellow-800">
            <p>📧 যোগাযোগ ফর্ম শীঘ্রই চালু হবে। জরুরি হলে সরাসরি ইমেইল করুন।</p>
          </div>
        )}
      </form>

      <div class="mt-8 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 shadow-sm">
        <h2 class="text-lg font-bold text-[var(--text)] mb-4">অন্যান্য যোগাযোগের মাধ্যম</h2>
        <ul class="space-y-3 text-sm text-[var(--text-muted)]">
          <li class="flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:info@shohojbd.pages.dev" class="text-[var(--primary)] hover:underline">info@shohojbd.pages.dev</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</Layout>
