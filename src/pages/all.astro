---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { getAllPosts, getCollectionLabel, formatDate } from "../lib/content";
import { buildBreadcrumbJsonLd } from "../lib/schema";

const POSTS_PER_PAGE = 12;

const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const currentPage = 1;
const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
const posts = sortedPosts.slice(0, POSTS_PER_PAGE);

const jsonLd = [
  buildBreadcrumbJsonLd([
    { title: "হোম", href: "/" },
    { title: "সব পোস্ট", href: "/all/" },
  ]),
];
---

<Layout
  title="সব পোস্ট"
  description="বাংলাদেশের সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্যের সব পোস্ট একসাথে।"
  url="https://shohojbd.pages.dev/all/"
  jsonLd={jsonLd}
>
  <div class="container py-8 md:py-12">
    <nav class="text-sm text-[var(--text-muted)] mb-6" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-[var(--primary)]">হোম</a></li>
        <li>/</li>
        <li class="text-[var(--text)] font-medium">সব পোস্ট</li>
      </ol>
    </nav>

    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-[var(--text)] mb-3">
        সব পোস্ট
      </h1>
      <p class="text-[var(--text-muted)] text-lg">
        বাংলাদেশের সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্যের সব আর্টিকেল একসাথে। মোট {sortedPosts.length}টি পোস্ট।
      </p>
    </div>

    <div class="card-grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>

    {totalPages > 1 && (
      <Pagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl="/all"
      />
    )}
  </div>
</Layout>
