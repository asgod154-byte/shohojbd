---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getAllPosts, buildTaxonomyIndex } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const allPosts = await getAllPosts();
const { categories } = buildTaxonomyIndex(allPosts);
const sortedCategories = Array.from(categories.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);

const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "বিভাগ", href: "/category/" },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title="বিভাগ"
  description="Shohoj BD-র সব বিভাগ। বিভিন্ন বিষয় অনুযায়ী পোস্ট ব্রাউজ করুন।"
  url="https://shohojbd.pages.dev/category/"
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">সব বিভাগ</h1>
    <p class="mt-3 text-lg text-slate-600">বিভাগ অনুযায়ী পোস্ট ব্রাউজ করুন।</p>
  </section>
  <div class="grid gap-4 sm:grid-cols-2">
    {sortedCategories.map(([slug, data]) => (
      <a
        href={`/category/${slug}/`}
        class="group rounded-xl border border-slate-200 bg-white p-5 transition hover:shadow-lg hover:-translate-y-0.5"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition">{data.label}</h2>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-sm font-semibold text-slate-500 group-hover:bg-emerald-50 group-hover:text-emerald-600 transition">
            {data.entries.length}
          </span>
        </div>
        <p class="mt-2 text-sm text-slate-500">{data.entries.length}টি পোস্ট</p>
      </a>
    ))}
  </div>
</LayoutWithSidebar>
