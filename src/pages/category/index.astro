---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getAllPosts, buildTaxonomyIndex } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const allPosts = await getAllPosts();
const { categories } = buildTaxonomyIndex(allPosts);
const sortedCategories = Array.from(categories.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);

const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "ক্যাটাগরি", href: "/category/" },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title="ক্যাটাগরি"
  description="Shohoj BD-র সব ক্যাটাগরি। বিভিন্ন বিষয় অনুযায়ী পোস্ট ব্রাউজ করুন।"
  url="https://shohojbd.pages.dev/category/"
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl">সব ক্যাটাগরি</h1>
    <p class="mt-3 text-lg text-[var(--text-muted)]">ক্যাটাগরি অনুযায়ী পোস্ট ব্রাউজ করুন।</p>
  </section>
  <div class="grid gap-4 sm:grid-cols-2">
    {sortedCategories.map(([slug, data]) => (
      <a
        href={`/category/${slug}/`}
        class="group rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 transition hover:shadow-lg hover:-translate-y-0.5"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-[var(--text)] group-hover:text-[var(--primary)] transition">{data.label}</h2>
          <span class="rounded-full bg-[var(--surface-muted)] px-3 py-1 text-sm font-semibold text-[var(--text-muted)] group-hover:bg-[var(--primary)]/10 group-hover:text-[var(--primary)] transition">
            {data.entries.length}
          </span>
        </div>
        <p class="mt-2 text-sm text-[var(--text-muted)]">{data.entries.length}টি পোস্ট</p>
      </a>
    ))}
  </div>
</LayoutWithSidebar>
