---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllPosts, buildTaxonomyIndex, slugify } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

export async function getStaticPaths() {
  const entries = await getAllPosts();
  const { categories } = buildTaxonomyIndex(entries);
  return Array.from(categories.keys()).map((slug) => ({ params: { slug } }));
}

const entries = await getAllPosts();
const { categories } = buildTaxonomyIndex(entries);
const { slug } = Astro.params;
let category = categories.get(slug);
if (!category) {
  const normalizedParam = String(slug).normalize("NFKD");
  category = Array.from(categories.values()).find((c) => {
    const s = slugify(c.label);
    return s === slug || s === normalizedParam;
  });
}
if (!category) throw new Error(`Category ${slug} not found`);

const siteUrl = `https://shohojbd.pages.dev/category/${slug}/`;
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "ক্যাটাগরি", href: "/category/" },
  { title: category.label, href: siteUrl },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title={`ক্যাটাগরি: ${category.label}`}
  description={`${category.label} ক্যাটাগরির সব পোস্ট। মোট ${category.entries.length}টি পোস্ট।`}
  url={siteUrl}
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">ক্যাটাগরি: {category.label}</h1>
    <p class="mt-3 text-lg text-slate-600">এই ক্যাটাগরির {category.entries.length}টি পোস্ট।</p>
  </section>
  <section class="grid gap-6 sm:grid-cols-2">
    {category.entries.map((entry) => (
      <PostCard post={entry} variant="vertical" />
    ))}
  </section>
</LayoutWithSidebar>
