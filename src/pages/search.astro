---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import SearchBox from "../components/SearchBox.astro";
import { getAllPosts, slugify } from "../lib/content";

const allPosts = await getAllPosts();
const query = Astro.url.searchParams.get("q") || "";

const results = query
  ? allPosts.filter((post) => {
      const q = query.toLowerCase();
      return (
        post.data.title.toLowerCase().includes(q) ||
        post.data.description.toLowerCase().includes(q) ||
        (post.data.tags || []).some((t: string) => t.toLowerCase().includes(q)) ||
        post.data.category.toLowerCase().includes(q) ||
        (post.body || "").toLowerCase().includes(q)
      );
    })
  : [];
---

<Layout
  title={query ? `"${query}"-এর অনুসন্ধান ফলাফল` : "অনুসন্ধান"}
  description="Shohoj BD-তে অনুসন্ধান করুন। সরকারি সেবা, শিক্ষা ও স্থানীয় তথ্য খুঁজুন।"
  url={`https://shohojbd.pages.dev/search/${query ? `?q=${encodeURIComponent(query)}` : ""}`}
  image="/social-share-default.svg"
>
  <div class="container mx-auto py-12">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl mb-6">অনুসন্ধান</h1>
      <div class="mb-8">
        <SearchBox />
      </div>

      {query ? (
        <>
          <p class="text-[var(--text-muted)] mb-6">
            <strong>"{query}"</strong>-এর জন্য {results.length}টি ফলাফল পাওয়া গেছে।
          </p>
          {results.length > 0 ? (
            <div class="grid gap-6 sm:grid-cols-2">
              {results.map((post) => (
                <PostCard post={post} variant="vertical" />
              ))}
            </div>
          ) : (
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-[var(--text-muted)] mb-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
              <h2 class="text-lg font-semibold text-[var(--text)]">কোনো ফলাফল পাওয়া যায়নি</h2>
              <p class="text-sm text-[var(--text-muted)] mt-1">অনুগ্রহ করে অন্য কীওয়ার্ড দিয়ে চেষ্টা করুন।</p>
            </div>
          )}
        </>
      ) : (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto text-[var(--text-muted)] mb-3"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <p class="text-[var(--text-muted)]">অনুসন্ধান করতে উপরের বক্সে কীওয়ার্ড লিখুন।</p>
        </div>
      )}
    </div>
  </div>
</Layout>


