---
import Layout from "../../layouts/Layout.astro";
import Sidebar from "../../components/Sidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import { getCollection, render } from "astro:content";
import { getEntrySlug, getEntryUrl, getCollectionLabel, getAllPosts, formatDate, estimateReadingTime } from "../../lib/content";
import { buildBreadcrumbJsonLd, buildArticleJsonLd, buildFaqJsonLd, buildHowToJsonLd } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("local-guide");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: getEntrySlug(post) },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const url = getEntryUrl(post);
const readingTime = estimateReadingTime(post.body || "");
const categoryLabel = getCollectionLabel("local-guide");

// Auto-generate meta description from post body if empty
const metaDescription = post.data.description || (post.body?.slice(0, 160).replace(/[#*`]/g, '').trim() + '...') || '';

// Auto-generate OG image from coverImage or fallback to default
const ogImage = post.data.coverImage || '/social-share-default.svg';

const allPosts = await getAllPosts();
const sortedPosts = [...allPosts].sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const currentIndex = sortedPosts.findIndex((p) => getEntrySlug(p) === getEntrySlug(post));
const prevPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;
const nextPost = currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;

const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: "/local-guide/" },
  { title: post.data.title, href: url },
];

const articleJsonLd = buildArticleJsonLd({
  title: post.data.title,
  description: metaDescription,
  url,
  pubDate: post.data.pubDate,
  updatedDate: post.data.updatedDate,
  author: post.data.author,
  image: ogImage,
});

const faqJsonLd = buildFaqJsonLd(post.data.faq);
const howToJsonLd = buildHowToJsonLd({
  title: post.data.title,
  description: metaDescription,
  url,
  steps: (post.data as any).steps,
});
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
const jsonLd = [articleJsonLd, breadcrumbJsonLd, faqJsonLd, howToJsonLd].filter(Boolean);
---

<Layout
  title={post.data.title}
  description={metaDescription}
  url={url}
  image={ogImage}
  jsonLd={jsonLd.length === 1 ? jsonLd[0] : jsonLd}
  article={true}
  pubDate={post.data.pubDate.toISOString()}
  updatedDate={(post.data.updatedDate || post.data.pubDate).toISOString()}
  author={post.data.author}
  category={post.data.category}
  tags={post.data.tags}
>
  <ReadingProgress />
  <div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
      <article class="min-w-0">
        <Breadcrumb items={breadcrumbItems} />

        {post.data.coverImage && (
          <div class="mb-6 aspect-video rounded-2xl overflow-hidden bg-amber-50">
            <img src={post.data.coverImage} alt={post.data.coverImageAlt || post.data.title} class="w-full h-full object-cover" width="1200" height="630" fetchpriority="high" />
          </div>
        )}

        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-3">
            <a href="/local-guide/" class="inline-flex items-center rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700 hover:bg-amber-100 transition">
              {categoryLabel}
            </a>
            <span class="text-xs text-slate-400">{formatDate(post.data.pubDate)}</span>
            {post.data.updatedDate && post.data.updatedDate.toISOString() !== post.data.pubDate.toISOString() && (
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-semibold text-amber-700">
                🔄 সর্বশেষ হালনাগাদ: {formatDate(post.data.updatedDate)}
              </span>
            )}
          </div>
          <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl lg:text-4xl leading-tight">{post.data.title}</h1>
          <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-slate-500">
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              {post.data.author}
              <span class="inline-flex items-center text-emerald-600" title="Verified author" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
            </span>
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {readingTime} মিনিট পড়ুন
            </span>
          </div>
        </header>

        <TableOfContents headings={headings} />

        <div class="prose prose-slate max-w-none prose-headings:font-bold prose-headings:text-slate-900 prose-a:text-emerald-700 prose-a:no-underline hover:prose-a:underline prose-blockquote:border-emerald-500 prose-blockquote:bg-emerald-50/50 prose-blockquote:rounded-r-lg prose-img:rounded-xl prose-table:border-collapse prose-th:bg-emerald-50 prose-th:font-semibold prose-td:border prose-td:border-slate-200 prose-th:border prose-th:border-slate-200">
          <Content />
        </div>

        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-slate-500 mr-1">ট্যাগ:</span>
            {post.data.tags.map((tag) => (
              <a href={`/tag/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="rounded-full bg-slate-100 px-3 py-1 text-sm text-slate-600 hover:bg-emerald-50 hover:text-emerald-700 transition">
                {tag}
              </a>
            ))}
          </div>
        )}

        {post.data.officialLinks && post.data.officialLinks.length > 0 && (
          <div class="mt-8 rounded-xl border border-slate-200 bg-white p-5">
            <h3 class="text-sm font-bold text-slate-900 mb-3 flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              অফিসিয়াল লিংক
            </h3>
            <ul class="space-y-2">
              {post.data.officialLinks.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-sm text-emerald-700 hover:underline inline-flex items-center gap-1">
                    {link.label}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* FAQ */}
        {post.data.faq && post.data.faq.length > 0 && (
          <section class="mt-8">
            <h3 class="text-xl font-bold mb-4 text-gray-900 dark:text-white">সচরাচর জিজ্ঞাসা</h3>
            {post.data.faq.map((item) => (
              <div class="mb-4 border border-gray-200 dark:border-gray-700 rounded-lg p-4 bg-white dark:bg-gray-800">
                <h4 class="font-semibold text-gray-900 dark:text-white">{item.question}</h4>
                <p class="mt-2 text-gray-600 dark:text-gray-300">{item.answer}</p>
              </div>
            ))}
          </section>
        )}

        <div class="mt-8 pt-6 border-t border-slate-200">
          <ShareButtons url={url} title={post.data.title} />
        </div>

        <AuthorBox author={post.data.author} />
        <RelatedPosts currentPost={post} posts={allPosts} />

        {/* Prev / Next Post Navigation */}
        <nav class="flex justify-between mt-12 pt-8 border-t border-gray-200 dark:border-gray-700" aria-label="Post navigation">
          {prevPost && (
            <a href={getEntryUrl(prevPost)} class="group inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-gray-700 px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition max-w-[45%]">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6"/></svg>
              <span class="line-clamp-1">{prevPost.data.title}</span>
            </a>
          )}
          <span></span>
          {nextPost && (
            <a href={getEntryUrl(nextPost)} class="group ml-auto inline-flex items-center gap-2 rounded-lg border border-gray-200 dark:border-gray-700 px-4 py-3 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 transition max-w-[45%]">
              <span class="line-clamp-1">{nextPost.data.title}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          )}
        </nav>
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <Sidebar />
        </div>
      </aside>
    </div>
  </div>
</Layout>
