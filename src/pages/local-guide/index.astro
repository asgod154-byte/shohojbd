---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { getCollectionLabel } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const posts = await getCollection("local-guide");
const sorted = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categoryLabel = getCollectionLabel("local-guide");
const baseUrl = `/local-guide/`;
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: baseUrl },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title={categoryLabel}
  description={`${categoryLabel} বিভাগের সব পোস্ট। পরিবহন, ভ্রমণ ও স্থানীয় সেবার তথ্য।`}
  url={`https://shohojbd.pages.dev${baseUrl}`}
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">{categoryLabel}</h1>
    <p class="mt-3 text-lg text-slate-600">
      পরিবহন, ভ্রমণ, স্থানীয় সেবা ও দর্শনীয় স্থানের তথ্য ও নির্দেশনা।
    </p>
  </section>
  <section class="grid gap-6 sm:grid-cols-2">
    {sorted.map((post) => (
      <PostCard post={post} variant="vertical" />
    ))}
  </section>
</LayoutWithSidebar>
