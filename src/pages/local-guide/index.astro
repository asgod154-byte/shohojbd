---
import PostList from "../../components/shared/PostList.astro";
import { getCollection } from "astro:content";
import { getCollectionLabel } from "../../lib/content";

const posts = await getCollection("local-guide");
const sorted = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categoryLabel = getCollectionLabel("local-guide");
const baseUrl = "/local-guide/";
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: baseUrl },
];
---

<PostList
  posts={sorted}
  title={categoryLabel}
  description={`${categoryLabel} ক্যাটাগরির সব পোস্ট। পরিবহন, ভ্রমণ ও স্থানীয় সেবার তথ্য।`}
  breadcrumbItems={breadcrumbItems}
/>