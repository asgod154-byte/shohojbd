---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getAllPosts, buildTaxonomyIndex, slugify } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const allPosts = await getAllPosts();
const { tags } = buildTaxonomyIndex(allPosts);
const sortedTags = Array.from(tags.entries()).sort((a, b) => b[1].entries.length - a[1].entries.length);

const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "ট্যাগ", href: "/tag/" },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title="ট্যাগ"
  description="Shohoj BD-র সব ট্যাগ। বিভিন্ন বিষয় অনুযায়ী পোস্ট ব্রাউজ করুন।"
  url="https://shohojbd.pages.dev/tag/"
  image="/social-share-default.svg"
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl">ট্যাগ</h1>
    <p class="mt-3 text-lg text-[var(--text-muted)]">সব ট্যাগ অনুযায়ী পোস্ট ব্রাউজ করুন।</p>
  </section>
  <div class="flex flex-wrap gap-3">
    {sortedTags.map(([slug, data]) => (
      <a
        href={`/tag/${slug}/`}
        class="group rounded-xl border border-[var(--border)] bg-[var(--surface)] px-5 py-3 transition hover:shadow-md hover:-translate-y-0.5"
      >
        <span class="text-base font-semibold text-[var(--text)] group-hover:text-[var(--primary)] transition">{data.label}</span>
        <span class="ml-2 rounded-full bg-[var(--surface-muted)] px-2 py-0.5 text-xs text-[var(--text-muted)] group-hover:bg-[var(--primary)]/10 group-hover:text-[var(--primary)] transition">
          {data.entries.length}
        </span>
      </a>
    ))}
  </div>
</LayoutWithSidebar>
