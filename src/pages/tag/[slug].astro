---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PostCard from "../../components/PostCard.astro";
import { buildBreadcrumbJsonLd } from "../../lib/schema";
import { getAllPosts, buildTaxonomyIndex, getEntryUrl, slugify } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getAllPosts();
  const { tags } = buildTaxonomyIndex(entries);
  return Array.from(tags.keys()).map((slug) => ({ params: { slug } }));
}

const entries = await getAllPosts();
const { tags } = buildTaxonomyIndex(entries);
  const { slug } = Astro.params;
  let tag = tags.get(slug);
  if (!tag) {
    tag = Array.from(tags.values()).find((t) => {
      const s = slugify(t.label);
      return s === slug;
    });
  }
if (!tag) throw new Error(`Tag ${slug} not found`);

const siteUrl = `https://shohojbd.pages.dev/tag/${slug}/`;
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "ট্যাগ", href: "/tag/" },
  { title: tag.label, href: siteUrl },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title={`ট্যাগ: ${tag.label}`}
  description={`${tag.label} ট্যাগের সব পোস্ট। মোট ${tag.entries.length}টি পোস্ট।`}
  url={siteUrl}
  image="/social-share-default.svg"
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl">ট্যাগ: {tag.label}</h1>
    <p class="mt-3 text-lg text-[var(--text-muted)]">এই ট্যাগের {tag.entries.length}টি পোস্ট।</p>
  </section>
  <section class="grid gap-6 sm:grid-cols-2">
    {tag.entries.map((entry: any) => (
      <PostCard post={entry} variant="vertical" />
    ))}
  </section>
</LayoutWithSidebar>
