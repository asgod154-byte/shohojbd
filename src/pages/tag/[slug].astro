---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import GuideCard from "../../components/GuideCard.astro";
import { buildBreadcrumbJsonLd } from "../../lib/schema";
import { getAllGuideEntries, buildTaxonomyIndex, getEntryUrl, slugify } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getAllGuideEntries();
  const { tags } = buildTaxonomyIndex(entries);
  return Array.from(tags.keys()).map((slug) => ({ params: { slug } }));
}

const entries = await getAllGuideEntries();
const { tags } = buildTaxonomyIndex(entries);
const { slug } = Astro.params;
let tag = tags.get(slug);
if (!tag) {
  // Fallback: try matching by slugifying the stored label to handle
  // Unicode normalization/composition differences between sources.
  const normalizedParam = String(slug).normalize && String(slug).normalize("NFKD");
  tag = Array.from(tags.values()).find((t) => {
    const s = slugify(t.label);
    return s === slug || (normalizedParam && s === normalizedParam);
  });
}
if (!tag) throw new Error(`Tag ${slug} not found`);
const siteUrl = `https://shohojbd.pages.dev/tag/${slug}/`;
const breadcrumbItems = [
  { title: "প্রথম পাতা", href: "/" },
  { title: "ট্যাগ", href: "/tag/" },
  { title: tag.label, href: siteUrl },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---
<Layout title={`Tag: ${tag.label}`} description={`Tag archive for ${tag.label}.`} url={siteUrl} jsonLd={jsonLd}>
  <Breadcrumb items={breadcrumbItems} />
  <section class="section-surface rounded-[2rem] border border-slate-200 p-6 shadow-sm sm:p-10">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold text-slate-900">ট্যাগ: {tag.label}</h1>
      <p class="mt-4 text-lg leading-8 text-slate-600">এই ট্যাগের সমস্ত গাইড একসাথে।</p>
    </div>
  </section>
  <section class="mt-8 grid gap-6 md:grid-cols-2">
    {tag.entries.map((entry) => (
      <GuideCard title={entry.data.title} description={entry.data.description} href={getEntryUrl(entry)} />
    ))}
  </section>
</Layout>
