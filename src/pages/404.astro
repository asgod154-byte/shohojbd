---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import SearchBox from "../components/SearchBox.astro";
import { getAllPosts } from "../lib/content";

const allPosts = await getAllPosts();
const suggested = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);
---

<Layout title="পেজটি পাওয়া যায়নি" description="আপনি যে পেজটি খুঁজছেন তা পাওয়া যায়নি।">
  <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-8 text-center shadow-sm sm:p-10">
      <div class="mb-4 text-7xl font-black text-[var(--primary)]">৪০৪</div>
      <h1 data-editable="source" data-path="/src/pages/404.astro" data-key="404_title" class="mb-3 text-3xl font-bold text-[var(--text)]">পেজটি পাওয়া যায়নি</h1>
      <p data-editable="source" data-path="/src/pages/404.astro" data-key="404_message" class="mb-8 text-lg text-[var(--text-muted)]">
        দুঃখিত, আপনি যে পেজটি খুঁজছেন তা বিদ্যমান নেই বা সরানো হয়েছে।
      </p>
      <div class="mb-8 w-full max-w-md mx-auto">
        <SearchBox />
      </div>
      <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-[var(--primary)] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        হোমপেজে যান
      </a>
    </div>

    {suggested.length > 0 && (
      <div class="mx-auto mt-16 max-w-4xl border-t border-[var(--border)] pt-10">
        <h2 class="mb-6 text-2xl font-bold text-[var(--text)]">আপনি যা খুঁজতে পারেন</h2>
        <div class="grid grid-cols-1 gap-4">
          {suggested.map((post) => (
            <PostCard post={post} variant="horizontal" />
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>
