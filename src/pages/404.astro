---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="পেজটি পাওয়া যায়নি"
  description="আপনি যে পেজটি খুঁজছেন তা পাওয়া যায়নি।"
>
  <div class="container mx-auto px-4 py-24 sm:px-6 lg:px-8 text-center">
    <div class="mx-auto max-w-lg">
      <div class="text-8xl font-extrabold text-emerald-100 mb-4">৪০৪</div>
      <h1 class="text-3xl font-bold text-slate-900 mb-3">পেজটি পাওয়া যায়নি</h1>
      <p class="text-lg text-slate-600 mb-8">
        দুঃখিত, আপনি যে পেজটি খুঁজছেন তা বিদ্যমান নেই বা সরানো হয়েছে।
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-6 py-3 text-sm font-semibold text-white hover:bg-emerald-500 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          হোমপেজে যান
        </a>
        <a href="/search/" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          অনুসন্ধান করুন
        </a>
      </div>
    </div>
  </div>
</Layout>
