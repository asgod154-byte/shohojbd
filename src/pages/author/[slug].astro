---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import PostCard from "../../components/PostCard.astro";
import { getAllPosts, buildTaxonomyIndex, slugify } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

export async function getStaticPaths() {
  const entries = await getAllPosts();
  const { authors } = buildTaxonomyIndex(entries);
  return Array.from(authors.keys()).map((slug) => ({ params: { slug } }));
}

const entries = await getAllPosts();
const { authors } = buildTaxonomyIndex(entries);
  const { slug } = Astro.params;
  let author = authors.get(slug);
  if (!author) {
    author = Array.from(authors.values()).find((a) => {
      const s = slugify(a.label);
      return s === slug;
    });
  }
  if (!author) {
    return Astro.redirect('/404/');
  }

const siteUrl = `https://shohojbd.pages.dev/author/${slug}/`;
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: "লেখক", href: "/author/" },
  { title: author.label, href: siteUrl },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title={`লেখক: ${author.label}`}
  description={`${author.label}-এর সব পোস্ট। মোট ${author.entries.length}টি পোস্ট।`}
  url={siteUrl}
  image="/social-share-default.svg"
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 text-2xl font-bold">
        {author.label.charAt(0)}
      </div>
      <div>
        <h1 class="text-3xl font-extrabold text-[var(--text)] sm:text-4xl">
          {author.label}
          <span class="inline-flex items-center text-emerald-600 ml-2" title="Verified author" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
        </h1>
        <p class="mt-1 text-lg text-[var(--text-muted)]">{author.entries.length}টি পোস্ট</p>
      </div>
    </div>
  </section>
  <section class="grid gap-6 sm:grid-cols-2">
    {author.entries.map((entry: any) => (
      <PostCard post={entry} variant="vertical" />
    ))}
  </section>
</LayoutWithSidebar>
