---
import PostList from "../../components/shared/PostList.astro";
import { getCollection } from "astro:content";
import { getCollectionLabel } from "../../lib/content";

const posts = await getCollection("sorkari-seba");
const sorted = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categoryLabel = getCollectionLabel("sorkari-seba");
const baseUrl = "/sorkari-seba/";
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: baseUrl },
];
---

<PostList
  posts={sorted}
  title={categoryLabel}
  description={`${categoryLabel} ক্যাটাগরির সব পোস্ট। সরকারি সেবা, NID, জন্ম নিবন্ধন, চাকরি ও আরও অনেক কিছু।`}
  breadcrumbItems={breadcrumbItems}
/>