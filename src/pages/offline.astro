---
import Layout from "../layouts/Layout.astro";
---

<Layout title="আপনি অফলাইনে আছেন" description="Shohoj BD অফলাইনে থাকাকালীন কনটেন্ট পড়তে এই পেইজে ফিরে আসুন।" url="https://shohojbd.pages.dev/offline/">
  <section class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.24em] text-emerald-700">Offline mode</p>
      <h1 class="text-3xl font-extrabold text-slate-900">আপনি এখন অফলাইনে আছেন</h1>
      <p class="mt-4 text-base text-slate-600">
        ইন্টারনেট সংযোগ ফিরে না আসা পর্যন্ত এই পেজটি দেখুন। আগের কনটেন্ট পড়তে আবার অনলাইনে ফিরে আসুন।
      </p>
      <a href="/" class="mt-6 inline-flex rounded-full bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-600">
        হোমে ফিরে যান
      </a>
    </div>
  </section>
</Layout>
