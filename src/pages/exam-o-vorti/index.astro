---
import PostList from "../../components/shared/PostList.astro";
import { getCollection } from "astro:content";
import { getCollectionLabel } from "../../lib/content";

const posts = await getCollection("exam-o-vorti");
const sorted = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categoryLabel = getCollectionLabel("exam-o-vorti");
const baseUrl = "/exam-o-vorti/";
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: baseUrl },
];
---

<PostList
  posts={sorted}
  title={categoryLabel}
  description={`${categoryLabel} ক্যাটাগরির সব পোস্ট। বিসিএস, বিশ্ববিদ্যালয় ভর্তি ও শিক্ষা সংক্রান্ত তথ্য।`}
  breadcrumbItems={breadcrumbItems}
/>