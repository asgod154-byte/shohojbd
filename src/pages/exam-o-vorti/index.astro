---
import LayoutWithSidebar from "../../layouts/LayoutWithSidebar.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection } from "astro:content";
import { getCollectionLabel } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const posts = await getCollection("exam-o-vorti");
const sorted = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const categoryLabel = getCollectionLabel("exam-o-vorti");
const baseUrl = `/exam-o-vorti/`;
const breadcrumbItems = [
  { title: "হোম", href: "/" },
  { title: categoryLabel, href: baseUrl },
];
const jsonLd = buildBreadcrumbJsonLd(breadcrumbItems);
---

<LayoutWithSidebar
  title={categoryLabel}
  description={`${categoryLabel} ক্যাটাগরির সব পোস্ট। বিসিএস, বিশ্ববিদ্যালয় ভর্তি ও শিক্ষা সংক্রান্ত তথ্য।`}
  url={`https://shohojbd.pages.dev${baseUrl}`}
  jsonLd={jsonLd}
>
  <Breadcrumb items={breadcrumbItems} />
  <section class="mb-8">
    <h1 class="text-3xl font-extrabold text-slate-900 sm:text-4xl">{categoryLabel}</h1>
    <p class="mt-3 text-lg text-slate-600">
      বিসিএস, বিশ্ববিদ্যালয় ভর্তি, শিক্ষা ও পরীক্ষা সংক্রান্ত সব তথ্য ও প্রস্তুতি কৌশল।
    </p>
  </section>
  <section class="grid gap-6 sm:grid-cols-2">
    {sorted.map((post) => (
      <PostCard post={post} variant="vertical" />
    ))}
  </section>
</LayoutWithSidebar>
