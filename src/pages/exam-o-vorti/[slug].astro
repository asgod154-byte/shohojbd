---
import PostDetail from "../../components/shared/PostDetail.astro";
import { getCollection } from "astro:content";
import { getEntrySlug } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getCollection("exam-o-vorti");
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: getEntrySlug(post) },
      props: { post },
    }));
}

const { post } = Astro.props;
---

<PostDetail post={post} type="exam-o-vorti" />