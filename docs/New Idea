১. global.css — .prose সেকশন রিপ্লেস করো
css
/* ============================================
   PROFESSIONAL ARTICLE STYLES
   ============================================ */

.prose {
  font-size: 1.0625rem;
  line-height: 1.85;
  color: var(--text);
}

/* --- Headings with visual hierarchy --- */
.prose h1 {
  font-size: 2.25rem;
  font-weight: 800;
  line-height: 1.2;
  margin-top: 0;
  margin-bottom: 1.25rem;
  color: var(--text);
  letter-spacing: -0.02em;
}

.prose h2 {
  font-size: 1.75rem;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 2.5rem;
  margin-bottom: 1rem;
  color: var(--text);
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--border);
  letter-spacing: -0.01em;
}

.prose h3 {
  font-size: 1.35rem;
  font-weight: 700;
  line-height: 1.35;
  margin-top: 2rem;
  margin-bottom: 0.75rem;
  color: var(--primary);
}

.prose h4 {
  font-size: 1.15rem;
  font-weight: 600;
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
  color: var(--text);
}

/* --- Paragraphs & spacing --- */
.prose p {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  text-align: justify;
  word-spacing: -0.5px;
}

.prose p + p {
  margin-top: 1rem;
}

/* --- Lead paragraph (first paragraph after h1) --- */
.prose h1 + p,
.prose .lead {
  font-size: 1.2rem;
  line-height: 1.7;
  color: var(--text-muted);
  text-align: left;
  border-left: 4px solid var(--primary);
  padding-left: 1.25rem;
  margin-bottom: 2rem;
}

/* --- Lists with custom styling --- */
.prose ul,
.prose ol {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  padding-left: 0;
  list-style: none;
}

.prose ul li {
  position: relative;
  padding-left: 1.75rem;
  margin-top: 0.6rem;
  margin-bottom: 0.6rem;
}

.prose ul li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: var(--primary);
  font-weight: 700;
  font-size: 1.1rem;
}

.prose ol {
  counter-reset: item;
}

.prose ol li {
  position: relative;
  padding-left: 2.5rem;
  margin-top: 0.75rem;
  margin-bottom: 0.75rem;
  counter-increment: item;
}

.prose ol li::before {
  content: counter(item);
  position: absolute;
  left: 0;
  top: 0;
  width: 1.75rem;
  height: 1.75rem;
  background: var(--primary);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  font-weight: 700;
}

/* --- Blockquote (styled callout) --- */
.prose blockquote {
  margin: 2rem 0;
  padding: 1.25rem 1.5rem;
  border-left: 4px solid var(--primary);
  background: color-mix(in srgb, var(--primary) 6%, var(--surface));
  border-radius: 0 0.75rem 0.75rem 0;
  font-style: normal;
  color: var(--text);
  position: relative;
}

.prose blockquote::before {
  content: """;
  font-size: 3rem;
  color: var(--primary);
  opacity: 0.3;
  position: absolute;
  top: -0.5rem;
  left: 0.75rem;
  line-height: 1;
  font-family: Georgia, serif;
}

.prose blockquote p {
  margin: 0;
  text-align: left;
}

/* --- Tables (professional striped) --- */
.prose table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 1.5rem 0;
  font-size: 0.95rem;
  border-radius: 0.75rem;
  overflow: hidden;
  border: 1px solid var(--border);
}

.prose thead {
  background: var(--primary);
  color: white;
}

.prose th {
  padding: 0.875rem 1rem;
  text-align: left;
  font-weight: 600;
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.prose td {
  padding: 0.75rem 1rem;
  text-align: left;
  border-bottom: 1px solid var(--border);
}

.prose tbody tr:nth-child(even) {
  background: var(--surface-muted);
}

.prose tbody tr:hover {
  background: color-mix(in srgb, var(--primary) 5%, var(--surface-muted));
}

.prose tbody tr:last-child td {
  border-bottom: none;
}

/* --- Images (polished) --- */
.prose img {
  border-radius: 1rem;
  max-width: 100%;
  height: auto;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  margin: 1.5rem 0;
  display: block;
}

.prose figure {
  margin: 2rem 0;
}

.prose figcaption {
  text-align: center;
  font-size: 0.9rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
  font-style: italic;
}

/* --- Code blocks (enhanced) --- */
.prose pre {
  background: #1e293b;
  color: #e2e8f0;
  padding: 1.25rem;
  border-radius: 1rem;
  overflow-x: auto;
  margin: 1.5rem 0;
  position: relative;
  font-size: 0.875rem;
  line-height: 1.7;
}

.prose pre code {
  background: transparent;
  color: inherit;
  padding: 0;
  font-size: 0.875rem;
}

.prose :not(pre) > code {
  background: color-mix(in srgb, var(--primary) 10%, var(--surface-muted));
  color: var(--primary);
  padding: 0.2rem 0.4rem;
  border-radius: 0.375rem;
  font-size: 0.9em;
  font-weight: 600;
  border: 1px solid color-mix(in srgb, var(--primary) 20%, transparent);
}

/* --- Horizontal rule (styled) --- */
.prose hr {
  border: none;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--border), transparent);
  margin: 2.5rem 0;
}

/* --- Links in content --- */
.prose a {
  color: var(--primary);
  text-decoration: none;
  border-bottom: 1px dashed var(--primary);
  transition: all 0.2s ease;
}

.prose a:hover {
  color: var(--accent-strong);
  border-bottom-style: solid;
}

/* --- Strong/Bold --- */
.prose strong {
  font-weight: 700;
  color: var(--text);
  background: color-mix(in srgb, var(--primary) 8%, transparent);
  padding: 0 0.2rem;
  border-radius: 0.25rem;
}

/* --- Dark mode adjustments --- */
[data-theme="dark"] .prose blockquote {
  background: color-mix(in srgb, var(--primary) 10%, var(--surface));
}

[data-theme="dark"] .prose pre {
  background: #0f172a;
  border: 1px solid var(--border);
}

[data-theme="dark"] .prose :not(pre) > code {
  background: color-mix(in srgb, var(--primary) 15%, var(--surface));
  border-color: color-mix(in srgb, var(--primary) 30%, transparent);
}

[data-theme="dark"] .prose table {
  border-color: var(--border);
}

[data-theme="dark"] .prose thead {
  background: color-mix(in srgb, var(--primary) 80%, black);
}

/* ============================================
   SPECIAL COMPONENTS (Add to markdown)
   ============================================ */

/* Info Box */
.info-box {
  background: color-mix(in srgb, #3b82f6 8%, var(--surface));
  border-left: 4px solid #3b82f6;
  padding: 1.25rem 1.5rem;
  border-radius: 0 0.75rem 0.75rem 0;
  margin: 1.5rem 0;
}

.info-box-title {
  font-weight: 700;
  color: #3b82f6;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Warning Box */
.warning-box {
  background: color-mix(in srgb, #f59e0b 8%, var(--surface));
  border-left: 4px solid #f59e0b;
  padding: 1.25rem 1.5rem;
  border-radius: 0 0.75rem 0.75rem 0;
  margin: 1.5rem 0;
}

.warning-box-title {
  font-weight: 700;
  color: #f59e0b;
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Success/Tips Box */
.tips-box {
  background: color-mix(in srgb, var(--primary) 8%, var(--surface));
  border-left: 4px solid var(--primary);
  padding: 1.25rem 1.5rem;
  border-radius: 0 0.75rem 0.75rem 0;
  margin: 1.5rem 0;
}

.tips-box-title {
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 0.5rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

/* Step Cards (for HowTo content) */
.step-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: 1.5rem;
  margin: 1.5rem 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  position: relative;
  padding-left: 4rem;
}

.step-number {
  position: absolute;
  left: 1.25rem;
  top: 1.5rem;
  width: 2.25rem;
  height: 2.25rem;
  background: var(--primary);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1rem;
}

.step-title {
  font-weight: 700;
  font-size: 1.15rem;
  color: var(--text);
  margin-bottom: 0.5rem;
}

/* Official Links Box */
.official-links-box {
  background: color-mix(in srgb, var(--primary) 5%, var(--surface));
  border: 1px solid var(--border);
  border-radius: 1rem;
  padding: 1.25rem 1.5rem;
  margin: 1.5rem 0;
}

.official-links-title {
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 0.75rem;
  font-size: 1.1rem;
}

.official-links-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.official-links-list li {
  margin: 0.5rem 0;
}

.official-links-list a {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--primary);
  font-weight: 500;
  text-decoration: none;
  border-bottom: none;
  padding: 0.25rem 0;
}

.official-links-list a:hover {
  text-decoration: underline;
}

/* FAQ Accordion Style */
.faq-item {
  border: 1px solid var(--border);
  border-radius: 0.75rem;
  margin: 0.75rem 0;
  overflow: hidden;
  background: var(--surface);
}

.faq-question {
  padding: 1rem 1.25rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--text);
}

.faq-answer {
  padding: 0 1.25rem 1.25rem;
  color: var(--text-muted);
  line-height: 1.7;
}

/* Related Posts / Read More */
.read-more-section {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 2px solid var(--border);
}

.read-more-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
  color: var(--text);
}
২. PostDetail.astro — স্পেশাল কম্পোনেন্ট যোগ করো
astro
---
// In the template, wrap official links like this:
---

{post.data.officialLinks && post.data.officialLinks.length > 0 && (
  <div class="official-links-box">
    <div class="official-links-title">📎 অফিসিয়াল লিংক</div>
    <ul class="official-links-list">
      {post.data.officialLinks.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            <span>↗</span> {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}

{post.data.faq && post.data.faq.length > 0 && (
  <div class="faq-section">
    <h2>❓ প্রায়শই জিজ্ঞাসিত প্রশ্নাবলী</h2>
    {post.data.faq.map((item, i) => (
      <div class="faq-item">
        <div class="faq-question">
          {item.question}
          <span>▼</span>
        </div>
        <div class="faq-answer">{item.answer}</div>
      </div>
    ))}
  </div>
)}

{post.data.steps && post.data.steps.length > 0 && (
  <div class="steps-section">
    <h2>📝 ধাপে ধাপে প্রক্রিয়া</h2>
    {post.data.steps.map((step, i) => (
      <div class="step-card">
        <div class="step-number">{i + 1}</div>
        {step.title && <div class="step-title">{step.title}</div>}
        <div class="step-description">{step.description}</div>
      </div>
    ))}
  </div>
)}
