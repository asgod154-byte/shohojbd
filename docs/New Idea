import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getAllPosts, getCollectionLabel } from "../../lib/content";
import { buildBreadcrumbJsonLd } from "../../lib/schema";

const POSTS_PER_PAGE = 12;

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  const sortedPosts = allPosts.sort(
    (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
  );
  const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
  
  if (totalPages <= 1) return [];
  
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { totalPages },
  }));
}

const { page } = Astro.params;
const { totalPages } = Astro.props;
const currentPage = Number(page);

const allPosts = await getAllPosts();
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
const start = (currentPage - 1) * POSTS_PER_PAGE;
const posts = sortedPosts.slice(start, start + POSTS_PER_PAGE);

const jsonLd = [
  buildBreadcrumbJsonLd([
    { title: "হোম", href: "/" },
    { title: "সব পোস্ট", href: "/all/" },
    { title: `পৃষ্ঠা ${currentPage}`, href: `/all/${currentPage}/` },
  ]),
];
